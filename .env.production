# Solana Network Configuration
# Options: devnet, testnet, mainnet-beta
EXPO_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Custom RPC endpoint (optional - leave empty to use default clusterApiUrl)
# For mainnet, you might want to use a custom RPC like Helius, QuickNode, etc.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://your-custom-rpc.com

# App Configuration
EXPO_PUBLIC_APP_NAME=21-S
EXPO_PUBLIC_APP_URI=https://21-s.app
